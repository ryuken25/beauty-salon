digraph LEGENDA {
  graph [rankdir=LR, nodesep=0.15, ranksep=1.1, bgcolor="white", pad=0.12];
  node [shape=box, style=filled, fillcolor="#FFFFFF", color="#FFFFFF", fontname="Helvetica", fontsize=11, width=0.1, height=0.28];
  edge [color="#2F2A26", penwidth=1.3, fontname="Helvetica", fontsize=11];
  a0 [label="", width=0.05];
  b0 [label="nol atau banyak", fontsize=11];
  a0 -> b0 [arrowhead=odotcrow, arrowtail=none, dir=forward];
  a1 [label="", width=0.05];
  b1 [label="satu atau banyak", fontsize=11];
  a1 -> b1 [arrowhead=teecrow, arrowtail=none, dir=forward];
  a2 [label="", width=0.05];
  b2 [label="nol atau satu", fontsize=11];
  a2 -> b2 [arrowhead=odottee, arrowtail=none, dir=forward];
  a3 [label="", width=0.05];
  b3 [label="tepat satu", fontsize=11];
  a3 -> b3 [arrowhead=teetee, arrowtail=none, dir=forward];
}
