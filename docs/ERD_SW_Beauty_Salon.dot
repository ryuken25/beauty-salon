    <TR><TD BGCOLOR="#FFFFFF" ALIGN="LEFT" PORT="is_active"><FONT POINT-SIZE="10"><B>&#160;&#160;</B>  is_active  <FONT COLOR="#8A8A8A">Tinyint</FONT></FONT></TD></TR>
    <TR><TD BGCOLOR="#FFFFFF" ALIGN="LEFT" PORT="created_at"><FONT POINT-SIZE="10"><B>&#160;&#160;</B>  created_at  <FONT COLOR="#8A8A8A">Datetime</FONT></FONT></TD></TR>
    <TR><TD BGCOLOR="#FFFFFF" ALIGN="LEFT" PORT="updated_at"><FONT POINT-SIZE="10"><B>&#160;&#160;</B>  updated_at  <FONT COLOR="#8A8A8A">Datetime</FONT></FONT></TD></TR>
    </TABLE>>];
