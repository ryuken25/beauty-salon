  bookings:id -> booking_logs:booking_id [arrowtail=teetee, arrowhead=odotcrow, label="1 : 0..N"];
  bookings:id -> booking_slots:booking_id [arrowtail=teetee, arrowhead=teecrow, label="1 : 1..N"];
  bookings:id -> transaksi:booking_id [arrowtail=teetee, arrowhead=odottee, label="1 : 0..1"];
  layanan:id -> bookings:layanan_id [arrowtail=teetee, arrowhead=odotcrow, label="1 : 0..N"];
  users:id -> bookings:user_id [arrowtail=odottee, arrowhead=odotcrow, label="1 : 0..N"];
}
