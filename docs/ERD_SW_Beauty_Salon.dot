digraph ERD {
  graph [rankdir=LR, nodesep=0.5, ranksep=1.6, bgcolor="white", pad=0.25];
  node  [shape=plaintext, fontname="Helvetica"];
  edge  [color="#2F2A26", penwidth=1.2, dir=both, fontname="Helvetica", fontsize=10, fontcolor="#444444"];

  users [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#2F2A26">
    <TR><TD BGCOLOR="#2F2A26" ALIGN="CENTER" PORT="__judul"><FONT COLOR="#FFFFFF" POINT-SIZE="13"><B>users</B></FONT></TD></TR>
    <TR><TD BGCOLOR="#FBF1DC" ALIGN="LEFT" PORT="id"><FONT POINT-SIZE="10"><B>PK</B>  <B>id</B>  <FONT COLOR="#8A8A8A">Bigint</FONT></FONT></TD></TR>
