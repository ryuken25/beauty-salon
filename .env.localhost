CI_ENVIRONMENT = development

app.baseURL = 'http://localhost:8080/'
app.indexPage = ''

database.default.hostname = localhost
database.default.database = sw_beauty_salon
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

# ── Email / Notifikasi (Gmail SMTP) ───────────────────────────
# Aktifkan 2-Step Verification di akun Gmail, buat "App Password" 16 huruf
# di https://myaccount.google.com/apppasswords, lalu isi email.SMTPPass.
# Tanpa SMTPHost/SMTPPass terisi, sistem skip pengiriman secara diam-diam —
# booking tetap sukses.
email.protocol   = 'smtp'
email.SMTPHost   = 'smtp.gmail.com'
email.SMTPUser   = 'kembarnadi76@gmail.com'
email.SMTPPass   =                                # isi pw App Password 16 huruf dari myaccount.google.com/apppasswords
email.SMTPPort   = 587
email.SMTPCrypto = 'tls'
email.fromEmail  = 'kembarnadi76@gmail.com'
email.fromName   = 'SW Beauty Salon'
email.mailType   = 'html'
