CI_ENVIRONMENT = development

app.baseURL = 'http://localhost:8080/'
app.indexPage = ''

database.default.hostname = 127.0.0.1
database.default.database = sw_beauty_salon
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

# ── Email / Notifikasi (Gmail SMTP) ───────────────────────────
# Opsional. Untuk mengaktifkan email: aktifkan 2-Step Verification di akun
# Gmail, buat "App Password" 16 huruf di https://myaccount.google.com/apppasswords,
# lalu isi email.SMTPUser + email.SMTPPass (16 huruf) + email.fromEmail.
# Tanpa SMTPUser/SMTPPass terisi, sistem skip pengiriman secara diam-diam —
# booking tetap sukses.
# CATATAN: JANGAN taruh komentar di belakang nilai (inline). CodeIgniter
# menolak nilai ber-spasi tanpa kutip, jadi tulis komentar di baris sendiri.
email.protocol   = 'smtp'
email.SMTPHost   = 'smtp.gmail.com'
email.SMTPUser   = ''
email.SMTPPass   = ''
email.SMTPPort   = 587
email.SMTPCrypto = 'tls'
email.fromEmail  = ''
email.fromName   = 'SW Beauty Salon'
email.mailType   = 'html'
