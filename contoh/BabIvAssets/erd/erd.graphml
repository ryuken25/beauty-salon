<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:y="http://www.yworks.com/xml/graphml"
  xmlns:yed="http://www.yworks.com/xml/yed/3"
  xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://www.yworks.com/xml/schema/graphml/1.1/ygraphml.xsd">
  <key for="node" id="d6" yfiles.type="nodegraphics"/>
  <key for="edge" id="d10" yfiles.type="edgegraphics"/>
  <graph edgedefault="directed" id="G">
    <node id="user">
      <data key="d6"><y:ShapeNode>
        <y:Geometry height="168" width="200" x="60" y="60"/>
        <y:Fill color="#FFFFFF" transparent="false"/>
        <y:BorderStyle color="#000000" type="line" width="1.0"/>
        <y:NodeLabel alignment="center" autoSizePolicy="content" fontSize="12"
          modelName="internal" modelPosition="c" visible="true">USER
PK iduser
username
password
role
created_at
updated_at</y:NodeLabel>
        <y:Shape type="rectangle"/>
      </y:ShapeNode></data>
    </node>
    <node id="jenis">
      <data key="d6"><y:ShapeNode>
        <y:Geometry height="88" width="200" x="400" y="60"/>
        <y:Fill color="#FFFFFF" transparent="false"/>
        <y:BorderStyle color="#000000" type="line" width="1.0"/>
        <y:NodeLabel alignment="center" autoSizePolicy="content" fontSize="12"
          modelName="internal" modelPosition="c" visible="true">JENIS
PK idjenis
nama</y:NodeLabel>
        <y:Shape type="rectangle"/>
      </y:ShapeNode></data>
    </node>
    <node id="merk">
      <data key="d6"><y:ShapeNode>
        <y:Geometry height="88" width="200" x="740" y="60"/>
        <y:Fill color="#FFFFFF" transparent="false"/>
        <y:BorderStyle color="#000000" type="line" width="1.0"/>
        <y:NodeLabel alignment="center" autoSizePolicy="content" fontSize="12"
          modelName="internal" modelPosition="c" visible="true">MERK
PK idmerk
nama</y:NodeLabel>
        <y:Shape type="rectangle"/>
      </y:ShapeNode></data>
    </node>
    <node id="barang">
      <data key="d6"><y:ShapeNode>
        <y:Geometry height="208" width="200" x="60" y="348"/>
        <y:Fill color="#FFFFFF" transparent="false"/>
        <y:BorderStyle color="#000000" type="line" width="1.0"/>
        <y:NodeLabel alignment="center" autoSizePolicy="content" fontSize="12"
          modelName="internal" modelPosition="c" visible="true">BARANG
PK idbarang
FK jenis
FK merk
nama
tipe
model
harga
harga_jasa</y:NodeLabel>
        <y:Shape type="rectangle"/>
      </y:ShapeNode></data>
    </node>
    <node id="sementara">
      <data key="d6"><y:ShapeNode>
        <y:Geometry height="188" width="200" x="400" y="348"/>
        <y:Fill color="#FFFFFF" transparent="false"/>
        <y:BorderStyle color="#000000" type="line" width="1.0"/>
        <y:NodeLabel alignment="center" autoSizePolicy="content" fontSize="12"
          modelName="internal" modelPosition="c" visible="true">SEMENTARA
PK idsementara
FK idbarang
jenis
merk
harga
qty
total</y:NodeLabel>
        <y:Shape type="rectangle"/>
      </y:ShapeNode></data>
    </node>
    <node id="transaksi">
      <data key="d6"><y:ShapeNode>
        <y:Geometry height="148" width="200" x="740" y="348"/>
        <y:Fill color="#FFFFFF" transparent="false"/>
        <y:BorderStyle color="#000000" type="line" width="1.0"/>
        <y:NodeLabel alignment="center" autoSizePolicy="content" fontSize="12"
          modelName="internal" modelPosition="c" visible="true">TRANSAKSI
PK idtransaksi
nama
total
tanggal
payment</y:NodeLabel>
        <y:Shape type="rectangle"/>
      </y:ShapeNode></data>
    </node>
    <node id="detail">
      <data key="d6"><y:ShapeNode>
        <y:Geometry height="168" width="200" x="60" y="676"/>
        <y:Fill color="#FFFFFF" transparent="false"/>
        <y:BorderStyle color="#000000" type="line" width="1.0"/>
        <y:NodeLabel alignment="center" autoSizePolicy="content" fontSize="12"
          modelName="internal" modelPosition="c" visible="true">DETAIL
PK iddetail
FK idtransaksi
FK idbarang
harga
qty
total</y:NodeLabel>
        <y:Shape type="rectangle"/>
      </y:ShapeNode></data>
    </node>
    <edge id="r0" source="jenis" target="barang">
      <data key="d10"><y:PolyLineEdge>
        <y:LineStyle color="#000000" type="line" width="1.0"/>
        <y:Arrows source="none" target="standard"/>
        <y:EdgeLabel backgroundColor="#FFFFFF" fontSize="10" modelName="centered" visible="true">1  menaungi  N</y:EdgeLabel>
        <y:BendStyle smoothed="false"/>
      </y:PolyLineEdge></data>
    </edge>
    <edge id="r1" source="merk" target="barang">
      <data key="d10"><y:PolyLineEdge>
        <y:LineStyle color="#000000" type="line" width="1.0"/>
        <y:Arrows source="none" target="standard"/>
        <y:EdgeLabel backgroundColor="#FFFFFF" fontSize="10" modelName="centered" visible="true">1  menaungi  N</y:EdgeLabel>
        <y:BendStyle smoothed="false"/>
      </y:PolyLineEdge></data>
    </edge>
    <edge id="r2" source="barang" target="detail">
      <data key="d10"><y:PolyLineEdge>
        <y:LineStyle color="#000000" type="line" width="1.0"/>
        <y:Arrows source="none" target="standard"/>
        <y:EdgeLabel backgroundColor="#FFFFFF" fontSize="10" modelName="centered" visible="true">1  tercatat_pada  N</y:EdgeLabel>
        <y:BendStyle smoothed="false"/>
      </y:PolyLineEdge></data>
    </edge>
    <edge id="r3" source="transaksi" target="detail">
      <data key="d10"><y:PolyLineEdge>
        <y:LineStyle color="#000000" type="line" width="1.0"/>
        <y:Arrows source="none" target="standard"/>
        <y:EdgeLabel backgroundColor="#FFFFFF" fontSize="10" modelName="centered" visible="true">1  memiliki  N</y:EdgeLabel>
        <y:BendStyle smoothed="false"/>
      </y:PolyLineEdge></data>
    </edge>
    <edge id="r4" source="barang" target="sementara">
      <data key="d10"><y:PolyLineEdge>
        <y:LineStyle color="#000000" type="line" width="1.0"/>
        <y:Arrows source="none" target="standard"/>
        <y:EdgeLabel backgroundColor="#FFFFFF" fontSize="10" modelName="centered" visible="true">1  dipilih_pada  N</y:EdgeLabel>
        <y:BendStyle smoothed="false"/>
      </y:PolyLineEdge></data>
    </edge>
  </graph>
</graphml>
