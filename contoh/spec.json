  "pengujian": {
    "blackbox": [
      {
        "judul": "Autentikasi & Sesi (Login/Logout)",
        "cases": [
          {
            "input": "Login dengan username & password benar",
            "expect": "Sistem menerima login dan mengarahkan ke dashboard sesuai peran",
            "observe": "Berhasil masuk ke dashboard sesuai peran",
            "result": "Sesuai"
          },
          {
            "input": "Login dengan password salah",
            "expect": "Sistem menolak login dan menampilkan pesan kesalahan",
            "observe": "Muncul pesan \"Username atau password salah\"",
            "result": "Sesuai"
          },
          {
            "input": "Klik logout",
            "expect": "Sesi pengguna dihapus dan kembali ke halaman login",
            "observe": "Sesi berakhir, kembali ke halaman login",
            "result": "Sesuai"
          }
        ]
      },
      {
        "judul": "Manajemen Data Barang",
        "cases": [
          {
            "input": "Menambah barang dengan data lengkap",
            "expect": "Data barang tersimpan dan tampil di daftar",
            "observe": "Data barang berhasil tersimpan",
            "result": "Sesuai"
          },
          {
            "input": "Menyimpan barang tanpa mengisi nama",
            "expect": "Sistem menolak dan menampilkan pesan validasi",
            "observe": "Muncul pesan \"Nama barang wajib diisi\"",
            "result": "Sesuai"
          },
          {
            "input": "Mengubah harga barang",
            "expect": "Harga ter-update sesuai input",
            "observe": "Harga barang berhasil diperbarui",
            "result": "Sesuai"
          },
          {
            "input": "Menghapus barang",
            "expect": "Data barang terhapus dari daftar",
            "observe": "Data barang berhasil dihapus",
            "result": "Sesuai"
          }
        ]
      },
      {
        "judul": "Transaksi Penjualan",
        "cases": [
          {
            "input": "Menambahkan barang ke keranjang transaksi",
            "expect": "Subtotal & total terhitung otomatis",
            "observe": "Subtotal dan total tampil dengan benar",
            "result": "Sesuai"
          },
          {
            "input": "Menyimpan transaksi dengan stok mencukupi",
            "expect": "Transaksi tersimpan & struk dapat dicetak",
            "observe": "Transaksi tersimpan, struk tercetak",
            "result": "Sesuai"
          },
          {
            "input": "Menyimpan transaksi melebihi stok",
            "expect": "Sistem menolak dan memberi peringatan stok",
            "observe": "Muncul peringatan stok tidak mencukupi",
            "result": "Sesuai"
          }
        ]
      },
      {
        "judul": "Laporan & Dashboard",
        "cases": [
          {
            "input": "Membuka dashboard",
            "expect": "Ringkasan penjualan & grafik tampil sesuai data",
            "observe": "Ringkasan dan grafik tampil sesuai data",
            "result": "Sesuai"
          },
          {
            "input": "Memfilter laporan berdasarkan rentang tanggal",
            "expect": "Laporan menampilkan data sesuai rentang",
            "observe": "Data laporan sesuai rentang tanggal",
            "result": "Sesuai"
          }
        ]
      }
    ]
  },
